# ─── AI Model ────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MODEL_NAME=claude-sonnet-4-5
MAX_RUN_COST_USD=2.00

# ─── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/centralign

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET=centralign-jwt-secret-key-change-in-production
JWT_TTL_SECONDS=300

# ─── Application Ports ────────────────────────────────────────
PORT=8000
FINANCE_APP_URL=http://localhost:8000
CLIENT_URL=http://localhost:5173

# ─── Policy ───────────────────────────────────────────────────
POLICY_AS_OF_DATE=2026-10-13

# ─── Browser Automation ───────────────────────────────────────
HEADLESS=1

# ─── Fault injection toggles (0 = disabled, 1 = enabled) ──────
INJECT_SESSION_EXPIRY=0
INJECT_VALIDATION_ERROR=0
INJECT_SLOW_PAGE=0
INJECT_TRANSIENT_500=0
